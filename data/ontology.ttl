    bkg:hasXref "Ensembl:ENSG00000134242"^^xsd:string,
        "HGNC:HGNC:9646"^^xsd:string,
        "NCBIGene:26191"^^xsd:string ;
    bkg:participatesInPathway bkg:PATHWAY_0005 .

bkg:associatedWithGene a owl:ObjectProperty ;
    rdfs:domain bkg:Gene ;
    rdfs:range bkg:Disease .

bkg:canonicalName a owl:DatatypeProperty .

bkg:hasSynonym a owl:DatatypeProperty .

bkg:hasXref a owl:DatatypeProperty .

bkg:ontology a owl:Ontology ;
    rdfs:label "Biomedical Knowledge Graph Ontology" ;
    dc:description "OWL ontology modeling biomedical entities (diseases, drugs, genes, pathways) and their relationships for entity resolution and knowledge-graph enrichment." .

bkg:participatesInPathway a owl:ObjectProperty ;
    rdfs:domain bkg:Gene ;
    rdfs:range bkg:Pathway .

bkg:targets a owl:ObjectProperty ;
    rdfs:domain bkg:Drug ;
    rdfs:range bkg:Pathway .

bkg:treats a owl:ObjectProperty ;
    rdfs:domain bkg:Drug ;
    rdfs:range bkg:Disease .

bkg:DISEASE_0002 a bkg:Disease,
