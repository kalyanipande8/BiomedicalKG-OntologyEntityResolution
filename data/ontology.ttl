@prefix bkg: <http://example.org/biomedkg#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

bkg:DRUG_0001 a bkg:Drug,
        owl:NamedIndividual ;
    bkg:canonicalName "Metformin"^^xsd:string ;
    bkg:hasSynonym "Dimethylbiguanide"^^xsd:string,
        "Glucophage"^^xsd:string,
        "Metformin HCl"^^xsd:string,
        "Metformin Hydrochloride"^^xsd:string ;
    bkg:hasXref "CHEMBL:CHEMBL1431"^^xsd:string,
        "DrugBank:DB00331"^^xsd:string,
        "RxNorm:6809"^^xsd:string ;
    bkg:targets bkg:PATHWAY_0001 ;
    bkg:treats bkg:DISEASE_0001 .

bkg:DRUG_0002 a bkg:Drug,
        owl:NamedIndividual ;
    bkg:canonicalName "Insulin Glargine"^^xsd:string ;
    bkg:hasSynonym "Glargine"^^xsd:string,
        "Insulin glargine recombinant"^^xsd:string,
        "Lantus"^^xsd:string ;
