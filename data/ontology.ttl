bkg:GENE_0006 a bkg:Gene,
        owl:NamedIndividual ;
    bkg:associatedWithGene bkg:DISEASE_0006 ;
    bkg:canonicalName "PTPN22"^^xsd:string ;
    bkg:hasSynonym "LYP"^^xsd:string,
