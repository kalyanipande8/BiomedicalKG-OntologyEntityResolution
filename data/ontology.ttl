        "HGNC:HGNC:11641"^^xsd:string,
        "NCBIGene:6934"^^xsd:string ;
    bkg:participatesInPathway bkg:PATHWAY_0001 .

bkg:GENE_0002 a bkg:Gene,
        owl:NamedIndividual ;
    bkg:associatedWithGene bkg:DISEASE_0002 ;
    bkg:canonicalName "INS"^^xsd:string ;
    bkg:hasSynonym "IDDM2"^^xsd:string,
        "Insulin gene"^^xsd:string,
        "Preproinsulin"^^xsd:string ;
