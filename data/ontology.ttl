bkg:BiomedicalEntity a owl:Class .

bkg:PATHWAY_0001 a bkg:Pathway,
        owl:NamedIndividual ;
    bkg:canonicalName "Insulin Signaling Pathway"^^xsd:string ;
    bkg:hasSynonym "Insulin receptor signaling"^^xsd:string,
        "Insulin signalling pathway"^^xsd:string ;
    bkg:hasXref "KEGG:hsa04910"^^xsd:string,
        "Reactome:R-HSA-74752"^^xsd:string .

bkg:Pathway a owl:Class ;
    rdfs:label "Pathway" ;
    rdfs:subClassOf bkg:BiomedicalEntity .

bkg:Disease a owl:Class ;
    rdfs:label "Disease" ;
    rdfs:subClassOf bkg:BiomedicalEntity .

bkg:Drug a owl:Class ;
    rdfs:label "Drug" ;
    rdfs:subClassOf bkg:BiomedicalEntity .

bkg:Gene a owl:Class ;
    rdfs:label "Gene" ;
    rdfs:subClassOf bkg:BiomedicalEntity .

