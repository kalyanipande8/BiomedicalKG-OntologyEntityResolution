        "DrugBank:DB00047"^^xsd:string,
        "RxNorm:274783"^^xsd:string ;
    bkg:targets bkg:PATHWAY_0001 ;
    bkg:treats bkg:DISEASE_0001,
        bkg:DISEASE_0002 .

bkg:DRUG_0003 a bkg:Drug,
