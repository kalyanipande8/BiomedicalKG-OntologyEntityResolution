    bkg:canonicalName "APOE"^^xsd:string ;
    bkg:hasSynonym "AD2"^^xsd:string,
        "Apolipoprotein E"^^xsd:string ;
    bkg:hasXref "Ensembl:ENSG00000130203"^^xsd:string,
        "HGNC:HGNC:613"^^xsd:string,
        "NCBIGene:348"^^xsd:string ;
    bkg:participatesInPathway bkg:PATHWAY_0003 .

bkg:GENE_0005 a bkg:Gene,
        owl:NamedIndividual ;
    bkg:associatedWithGene bkg:DISEASE_0005 ;
