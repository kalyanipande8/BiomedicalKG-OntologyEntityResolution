bkg:DISEASE_0001 a bkg:Disease,
        owl:NamedIndividual ;
    bkg:canonicalName "Type 2 Diabetes Mellitus"^^xsd:string ;
    bkg:hasSynonym "Adult-onset diabetes"^^xsd:string,
        "Diabetes Mellitus Type 2"^^xsd:string,
        "Non-insulin-dependent diabetes mellitus"^^xsd:string,
        "T2DM"^^xsd:string,
        "Type 2 Diabetes"^^xsd:string ;
