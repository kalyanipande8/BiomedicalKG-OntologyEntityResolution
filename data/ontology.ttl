bkg:GENE_0001 a bkg:Gene,
        owl:NamedIndividual ;
    bkg:associatedWithGene bkg:DISEASE_0001 ;
    bkg:canonicalName "TCF7L2"^^xsd:string ;
    bkg:hasSynonym "TCF-4"^^xsd:string,
        "TCF4-like 2"^^xsd:string,
